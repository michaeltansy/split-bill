# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting (Upstash Redis) — optional. If unset, rate limiting is disabled.
# Create a free Redis DB at https://console.upstash.com/redis and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional tuning (defaults: 30 requests per 10 seconds per IP)
# UPSTASH_RATELIMIT_REQUESTS=30
# UPSTASH_RATELIMIT_WINDOW=10 s
