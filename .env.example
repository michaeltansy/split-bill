# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bill image scan via Google Gemini (free tier).
# Free tier limits on gemini-2.5-flash-lite: ~30 RPM / 1000 RPD.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Set to 'true' to surface the scan UI on the create-session page (build-time flag).
NEXT_PUBLIC_OCR_ENABLED=false

# Rate limiting (Upstash Redis) — optional. If unset, rate limiting is disabled.
# Create a free Redis DB at https://console.upstash.com/redis and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional tuning (defaults: 30 requests per 10 seconds per IP)
# UPSTASH_RATELIMIT_REQUESTS=30
# UPSTASH_RATELIMIT_WINDOW=10 s
